# /etc/systemd/system/level0.service
[Unit]
Description=LEVEL 0 multiplayer server
After=network.target

[Service]
WorkingDirectory=/opt/level0/server
Environment=PORT=8791
Environment=HOST=127.0.0.1
Environment=DATA=/var/lib/level0/level0.json
Environment=MAX_PER_IP=40
ExecStart=/usr/bin/env node server.mjs
Restart=always
RestartSec=3
DynamicUser=yes
StateDirectory=level0
MemoryMax=160M
CPUQuota=60%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
